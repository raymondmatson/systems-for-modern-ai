{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "concept.schema.json",
  "title": "Systems for Modern AI — Global Concept Metadata",
  "description": "Schema for canonical global Concept YAML records. Long-form educational prose belongs in the paired Markdown content file. Concept identity is global and independent of Organizational Content Inventory placement and Reference-System identity.",
  "type": "object",
  "required": [
    "schema_version",
    "concept_id",
    "name",
    "concept_kind",
    "summary",
    "content_file"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "concept_id": {
      "$ref": "#/$defs/conceptId"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "concept_kind": {
      "enum": [
        "principle",
        "mechanism",
        "protocol_standard",
        "topology",
        "operation_workflow",
        "metric",
        "software_abstraction",
        "hardware_technology",
        "comparison_distinction"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 500
    },
    "content_file": {
      "type": "string",
      "pattern": "^\\.\\./content/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "inventory_mappings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/inventoryMapping"
      }
    },
    "relationships": {
      "$ref": "#/$defs/relationships"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/tag"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "conceptId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "inventoryMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "item", "primary"],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "item": {
          "type": "string",
          "minLength": 1
        },
        "primary": {
          "type": "boolean"
        }
      }
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "prerequisites": {
          "$ref": "#/$defs/conceptIdList"
        },
        "specializes": {
          "$ref": "#/$defs/conceptIdList"
        },
        "contrasts_with": {
          "$ref": "#/$defs/conceptIdList"
        },
        "related": {
          "$ref": "#/$defs/conceptIdList"
        }
      }
    },
    "conceptIdList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/conceptId"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "url"],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
